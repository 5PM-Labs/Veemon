# Repo-root build context: the Go module (go.mod) lives at the repository root,
# so the Dockerfile COPYs cmd/, internal/, migrations/ only. Everything else
# here would still be sent to the daemon unless excluded.
.env
.env.local
.env.*.local
.git
.gitignore
.github
bin/
dist/
build/
tmp/
temp/
vendor/
*.log
logs/
coverage.out
coverage.html
*.test
.idea/
.vscode/
.DS_Store
Thumbs.db
.claude/
.qoder/
docs/
apps/
packages/
contract/
examples/
**/node_modules/
**/src-tauri/target/
.worktrees/
